# Copie este arquivo para .env e preencha os valores reais.
# O arquivo .env NAO deve ser versionado (ja esta no .gitignore).

# --- Agente de IA (app `ai`) ---

# Chave da API DeepSeek. Obtida em https://platform.deepseek.com/
# Sem esta chave a funcionalidade de analise por IA fica desligada.
DEEPSEEK_API_KEY=

# Identificador do modelo usado pelo ChatDeepSeek.
# Confira na documentacao da DeepSeek o id da versao vigente.
DEEPSEEK_MODEL=deepseek-chat

# Liga/desliga a funcionalidade. Mesmo com True, fica desligada sem a chave.
AI_ANALYSIS_ENABLED=True

# Intervalo minimo entre analises sob demanda do mesmo usuario (minutos).
AI_ANALYSIS_MIN_INTERVAL_MINUTES=15

# Timeout de uma execucao do agente (segundos).
AI_AGENT_TIMEOUT_SECONDS=60

# Teto de chamadas ao modelo no loop do agente.
AI_AGENT_MAX_ITERATIONS=10

# Janela padrao de meses considerada na analise.
AI_ANALYSIS_MONTHS_WINDOW=6

# --- Banco de dados ---

# Caminho do arquivo SQLite. Se ausente, usa BASE_DIR/db.sqlite3.
# No docker-compose aponta para o volume: /app/data/db.sqlite3
# DJANGO_DB_PATH=
